# Snowflake connection for snowflakes_consumer.py.
# The script reads these from the environment. In PowerShell, for example:
#   $env:SNOWFLAKE_USER = "..."
#   $env:SNOWFLAKE_PASSWORD = "..."
#   $env:SNOWFLAKE_ACCOUNT = "..."
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=

# Optional; these are the defaults.
SNOWFLAKE_DATABASE=KAFKA_DB
SNOWFLAKE_SCHEMA=KAFKA_DB_STREAMING
COMPUTE_WH=COMPUTE_WH
